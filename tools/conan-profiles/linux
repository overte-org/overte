include(default)

[settings]
compiler.cppstd=gnu20

[conf]
# Avoid dependencies failing to build on GCC 15 and newer.
tools.build:cxxflags=['-include', 'cstdint']

[tool_requires]
# Get CMake from Conan, in case the system has a CMake version which is too new for the dependencies to build.
!cmake/*: cmake/4.3.2

[options]
# Required for building oneTBB.
hwloc/*:shared=True

# Options required for building Qt
# Some Qt options are here rather than Overte's conanfile.py to allow for easier usage during Qt package development.
# Version conflict and not needed.
qt*:with_mysql=False
# PulseAudio is used for audio output on Linux.
qt*:with_pulseaudio=True
# Required by qt:with_pulseaudio
pulseaudio*:with_glib=True
# PulseAudio cannot find system OpenSSL, so we just build without.
pulseaudio*:with_openssl=False
# Required for PulseAudio support in Qt.
qt*:with_glib=True
# libpq build error and not needed (PostgreSQL).
qt*:with_pq=False
# Open Database Connectivity
# Avoid additional dependency on iconv.
qt*:with_odbc=False
# Build as shared, to avoid: `Invalid: NSS recipe cannot yet build static library. Contributions are welcome.`
# Required by Qt WebEngine
nss*:shared=True
nspr*:shared=True
# Work around `undefined reference` errors when building NSS.
sqlite3*:shared=True
qt*:with_dbus=True
# Work around `undefined reference` errors when building Qt6.
glib*:shared=True
freetype*:shared=True
#harfbuzz*:shared=True Probably not needed anymore because of subset being disabled.
# `v8_context_snapshot_generator` uses system libraries during v8 compilation (Qt WebEngine). Later harfbuzz versions have a libharfbuzz-subset0 which isn't available on Ubuntu 22.04.
#harfbuzz*:with_subset=False
# We might be able to get away with: qt*:with_harfbuzz=False instead.
qt*:with_harfbuzz=False
# The Conan Center Qt6 package builds without JPEG support by default.
qt*:with_libjpeg=libjpeg
